{
  "name": "quesos-san-francisco",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,green \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "test": "npm run test -w server",
    "audit": "npm audit --workspaces --audit-level=high"
  },
  "devDependencies": {
    "concurrently": "9.2.5"
  }
}
